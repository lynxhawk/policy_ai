{
    "政策编号": "POL0008",
    "标题": "就业见习补贴",
    "条件": {
      "逻辑": "OR",
      "规则": [
        {
          "逻辑": "AND",
          "规则": [
            {"字段": "毕业时间", "操作符": "<=", "值": "2年", "描述": "毕业2年以内"},
            {"字段": "就业类型", "操作符": "=", "值": "未就业", "描述": "尚未就业"}
          ]
        },
        {
          "逻辑": "AND", 
          "规则": [
            {"字段": "年龄", "操作符": "between", "值": [16, 24], "描述": "16-24岁"},
            {"字段": "就业类型", "操作符": "=", "值": "未就业", "描述": "失业青年"}
          ]
        }
      ]
    },
    "类型": "个人"
  }